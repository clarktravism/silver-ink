#EVENT ANIMATE
#IF DIFF THISX PLAYERX <= 2 #FIRE
#IF DIFF THISY PLAYERY <= 2 #FIRE
:NOFIRE
#IDLE
#RESTART
:FIRE
#IF RANDOM 0 10 >= SELF:FIRERATE #NOFIRE
#IF SELF:INTELLIGENCE < RANDOM 0 10 #RNDSHOOT
#SHOOT SEEK EBULLET
#RESTART
:RNDSHOOT
#SHOOT RND EBULLET
#RESTART
:ANIMATE
#SET SELF:FRAME MOD TICK 8
#IF SELF:FRAME < 2 #CHAR 24
#ELSE IF SELF:FRAME < 4 #CHAR 26
#ELSE IF SELF:FRAME < 6 #CHAR 25
#ELSE #CHAR 27
#END