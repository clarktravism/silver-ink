#IF CONTACT #POKE
#IF ALIGNED #TRY SEEK #GOTO THUD
#ELSE #IF DIFF THISY PLAYERY <= SUB 8 SELF:SENSITIVITY #TRY SEEK #THUD
#ELSE #IF DIFF THISX PLAYERX <= SUB 8 SELF:SENSITIVITY #TRY SEEK #THUD
#IDLE
#RESTART
:THUD
#IF DETECT SEEK BREAKABLE #EVENT SEEK BREAK
#AND DIE
#IDLE
#RESTART
:POKE
#EVENT PLAYER:ATTACK
:SHOT
#DIE