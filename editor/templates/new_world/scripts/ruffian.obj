#IDLE
#IF STEPX == 0 IF STEPY == 0 #RESTING
#IF ALIGNED IF SELF:INTELLIGENCE > RANDOM 0 9 #WALK SEEK
#IF ADD SELF:RESTTIME 8 <= RANDOM 0 17 #WALK IDLE
#RESTART
:RESTING
#IF ADD SELF:RESTTIME 8 > RANDOM 0 17 #RESTART
#IF SELF:INTELLIGENCE > RANDOM 0 9 #WALK SEEK
#ELSE #WALK RND
#RESTART
:THUD
#IF DETECT FLOW PLAYER #POKE
#WALK I
#END
:POKE
#EVENT PLAYER:ATTACK
:SHOT
#DIE